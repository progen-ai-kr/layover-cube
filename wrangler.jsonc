{
  "name": "layover-cube",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/admin/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "layover-cube",
    "GITHUB_BRANCH": "main",
    "GITHUB_REPOS": "layover-cube,layover-weave",
    "ADMIN_ENABLED": "true"
  }
}
