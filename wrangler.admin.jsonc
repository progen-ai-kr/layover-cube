{
  "name": "layover-admin",
  "compatibility_date": "2025-01-01",
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "progen-ai-kr",
    "GITHUB_REPO": "layover-cube",
    "GITHUB_REPOS": "layover-cube,layover-weave",
    "GITHUB_BRANCH": "main",
    "ADMIN_ENABLED": "true",
    "ADMIN_STANDALONE": "true",
    "ADMIN_URL": "https://layover-admin.progen-web.workers.dev/admin",
    "PUBLIC_SITE_URL": "https://layover-cube.progen-web.workers.dev"
  }
}
